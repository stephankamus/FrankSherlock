# Environment for `docker compose` in sherlock/web.
#
#   cp .env.example .env    # then edit the paths
#   docker compose up -d --build
#
# Compose reads this file from the directory that holds docker-compose.yml, so the
# real `.env` stays local — it is git-ignored.

# Optional read-only API token. It is accepted next to the accounts published by the
# desktop app and is useful for scripts and for the first deployment. Leave it empty
# when only user logins should be accepted:
#
#   openssl rand -hex 24
AUTH_TOKEN=

# Mark the session cookie `Secure`. The server also infers it from
# `X-Forwarded-Proto: https`, so a TLS-terminating reverse proxy normally needs nothing
# here. Set to 1 to force it, or for a TLS listener that does not send the header.
COOKIE_SECURE=0

# Host path of the folder chosen in Settings -> Publicação. It is mounted read-only
# at /library and must contain `current.json`, the snapshots and `thumbs/`.
#
# SMB: prefer a kernel mount (`mount -t cifs`, see docs/web-deploy.md section 2) at a
# plain path like /mnt/omv-desenvolvimento. A GVFS path such as
# /run/user/1000/gvfs/smb-share:server=nas,share=x also works — compose handles the
# colons — but only while your session is open, and it needs SHERLOCK_UID/SHERLOCK_GID
# below because /run/user/1000 is 0700 and the image runs as uid 10001.
PUBLISH_DIR=/mnt/publish

# Host path of the photo root that fills /mnt/fotos in the container. Every root in
# `config/media.map.json` needs its own bind mount: add the pair in
# docker-compose.yml (`source: ${VIDEOS_DIR:-/mnt/videos}`) and the matching
# `mountedPath` in the media map, otherwise that root shows up as unmapped.
PHOTOS_DIR=/mnt/fotos

# The image runs as uid/gid 10001. Reading a GVFS mount (/run/user/1000/..., mode 0700)
# requires the container to run as the user that owns it — uncomment both for that case.
# Leave them out when PUBLISH_DIR/PHOTOS_DIR are `mount -t cifs` paths.
# SHERLOCK_UID=1000
# SHERLOCK_GID=1000

# Fixed inside docker-compose.yml, listed here only so the meaning is not a mystery:
#
#   LIBRARY_DIR=/library          where PUBLISH_DIR is mounted
#   MEDIA_MAP=/config/media.map.json   storedPath -> mountedPath translation
#   CACHE_DIR=/tmp/fs-web-cache   disposable ?w= derivative cache (tmpfs)
#   PORT=8080                     listener inside the container
#   RUST_LOG=info                 raise to `debug` when troubleshooting
#
# Also reserved by the server, not implemented yet (slow shares):
#   LIBRARY_COPY_TO_LOCAL=1
